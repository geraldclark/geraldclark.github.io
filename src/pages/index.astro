---
import Base from '../layouts/Base.astro';
import StatusBar from '../components/StatusBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CloseTabModal from '../components/CloseTabModal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AboutCodeBlock from '../components/AboutCodeBlock.astro';
import HeroTerminal from '../components/HeroTerminal.astro';
import {
  getPortfolio,
  getProjects,
  HOME_PROJECTS_DESKTOP_INITIAL,
  portfolioExperienceYears,
} from '../lib/portfolio.js';
import {
  personSchema,
  websiteSchema,
  projectListSchema,
} from '../lib/schema.js';

const portfolio = getPortfolio();
const projects = getProjects();
const hiddenDesktopCount = Math.max(0, projects.length - HOME_PROJECTS_DESKTOP_INITIAL);
const about = portfolio.about;
const skills = portfolio.skills || [];
const contact = portfolio.contact || [];
const distinctions = portfolio.distinctions || [];

const onlineCount = projects.filter((p) => p.status === 'online').length;
const experience = portfolioExperienceYears(about, projects);

const locationParts = (about.location || '').split(',').map((part) => part.trim());
const locationCity = locationParts[0] || about.location || '';
const locationRegionRaw = locationParts[1] || '';
const locationRegion =
  locationRegionRaw === 'PA' ? 'Pennsylvania' : locationRegionRaw || 'Pennsylvania';

const description =
  'Portfolio of Gerald Clark, CTO and Co-Founder at Upsert. SugarAI plugins, architecture, and consulting work from Pittsburgh, PA.';

const jsonLd = [personSchema(), websiteSchema(), projectListSchema(projects)];
---

<Base
  title="Gerald Clark - Portfolio"
  description={description}
  image="/img/logo.png"
  jsonLd={jsonLd}
>
  <div class="dashboard-container">
    <StatusBar active="home" tabControls />

    <main class="dashboard">
      <section class="hero-section" id="top">
        <HeroTerminal
          about={about}
          projects={projects}
          skills={skills}
          distinctions={distinctions}
          contact={contact}
        />
      </section>

      <section class="stats-grid" aria-label="Portfolio stats">
        <div class="stat-card surface-card-interactive">
          <div class="stat-card-heading">
            <span class="accent-icon-badge accent-icon-badge--sm" aria-hidden="true">
              <i class="fas fa-folder-open"></i>
            </span>
            <div class="stat-label">Projects</div>
          </div>
          <div class="stat-value">{projects.length}</div>
          <div class="stat-footer">Plugins, platforms and writing</div>
        </div>
        <div class="stat-card surface-card-interactive">
          <div class="stat-card-heading">
            <span class="accent-icon-badge accent-icon-badge--sm accent-icon-badge--green" aria-hidden="true">
              <i class="fas fa-signal"></i>
            </span>
            <div class="stat-label">Live</div>
          </div>
          <div class="stat-value">{onlineCount}</div>
          <div class="stat-footer">Projects maintained</div>
        </div>
        <div class="stat-card surface-card-interactive">
          <div class="stat-card-heading">
            <span class="accent-icon-badge accent-icon-badge--sm" aria-hidden="true">
              <i class="fas fa-hourglass-half"></i>
            </span>
            <div class="stat-label">Experience</div>
          </div>
          <div
            class="stat-value"
            id="crm-experience-value"
            data-crm-experience-since={experience?.since}
          >
            {experience ? `${experience.span}+` : 'N/A'}
          </div>
          {
            experience && (
              <div class="stat-footer" id="crm-experience-footer" data-crm-experience-footer>
                Years experience
              </div>
            )
          }
        </div>
        <div class="stat-card surface-card-interactive">
          <div class="stat-card-heading">
            <span class="accent-icon-badge accent-icon-badge--sm" aria-hidden="true">
              <i class="fas fa-location-dot"></i>
            </span>
            <div class="stat-label">Location</div>
          </div>
          <div class="stat-value stat-value-location">{locationCity}</div>
          {locationRegion && <div class="stat-footer">{locationRegion}</div>}
        </div>
      </section>

      <section id="about" class="content-section">
        <div class="section-header">
          <h2 class="section-title">About.js</h2>
          <div class="section-line"></div>
        </div>
        <p class="section-intro">The short version.</p>
        <div class="content-card content-card--accent">
          <AboutCodeBlock about={about} />
        </div>
      </section>

      <section id="projects" class="content-section">
        <div class="section-header">
          <h2 class="section-title">Projects.log</h2>
          <div class="section-line"></div>
        </div>
        <p class="section-intro">
          What I've been building lately.{' '}
          <a href="/projects/">All {projects.length} projects</a>
        </p>
        <div class="projects-grid home-projects-grid" data-home-projects-grid>
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
        {
          hiddenDesktopCount > 0 && (
            <div class="home-projects-actions">
              <button type="button" class="home-projects-view-more" data-home-projects-expand>
                View more ({hiddenDesktopCount})
              </button>
            </div>
          )
        }
      </section>

      <section id="skills" class="content-section">
        <div class="section-header">
          <h2 class="section-title">Skills.yml</h2>
          <div class="section-line"></div>
        </div>
        <p class="section-intro">What I reach for day to day.</p>
        <div class="skills-container">
          {
            skills.map((skill) => (
              <article class="skill-category surface-card-interactive">
                <h3 class="skill-category-title">
                  {
                    skill.icon && (
                      <span class="accent-icon-badge accent-icon-badge--sm">
                        <i class={skill.icon} aria-hidden="true"></i>
                      </span>
                    )
                  }
                  {skill.category}
                </h3>
                <ul class="skill-list skill-list--yaml">
                  {(skill.items || []).map((item) => (
                    <li class="skill-item">
                      <span class="skill-item-marker" aria-hidden="true">-</span>
                      <span class="skill-item-name">{item.name}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="distinctions" class="content-section">
        <div class="section-header">
          <h2 class="section-title">Distinctions.crt</h2>
          <div class="section-line"></div>
        </div>
        <p class="section-intro">Certs and milestones worth mentioning.</p>
        <div class="content-card content-card--accent">
          <div class="distinctions-container">
            {
              distinctions.map((item) => (
                <article class="distinction-card surface-card-interactive">
                  {
                    item.icon && (
                      <span class="accent-icon-badge">
                        <i class={item.icon} aria-hidden="true"></i>
                      </span>
                    )
                  }
                  <div class="distinction-card-body">
                    <h3 class="distinction-card-title">{item.name}</h3>
                    <p class="distinction-card-meta">
                      <span class="distinction-card-issuer">{item.issuer}</span>
                      {item.year && <span class="accent-meta-pill">{item.year}</span>}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="contact" class="content-section">
        <div class="section-header">
          <h2 class="section-title"># Contact.md</h2>
          <div class="section-line"></div>
        </div>
        <p class="section-intro">Let's connect!</p>
        <div class="content-card content-card--accent">
          <div class="contact-grid contact-grid-static">
            {
              contact.map((item) => (
                <a
                  class="contact-item surface-card-interactive"
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {
                    item.icon && (
                      <span class="contact-icon">
                        <i class={item.icon} aria-hidden="true"></i>
                      </span>
                    )
                  }
                  <span class="contact-label">{item.label}</span>
                  <span class="contact-value">{item.value}</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <CloseTabModal />
  </div>
</Base>
