---
import Base from '../../layouts/Base.astro';
import StatusBar from '../../components/StatusBar.astro';
import ProjectBrowser from '../../components/ProjectBrowser.astro';
import ProjectImageLightbox from '../../components/ProjectImageLightbox.astro';
import {
  getProjects,
  getProjectById,
  projectSummary,
  projectImagePath,
  projectLogoPath,
  projectImageIsLogo,
  projectYear,
  formatProjectStatus,
} from '../../lib/portfolio.js';
import { projectSchema, breadcrumbSchema } from '../../lib/schema.js';

export function getStaticPaths() {
  return getProjects().map((project) => ({
    params: { id: project.id },
  }));
}

const { id } = Astro.params;
const project = getProjectById(id);

if (!project) {
  throw new Error(`Unknown project: ${id}`);
}

const summary = projectSummary(project);
const title = `${project.name} | Gerald Clark`;
const description = summary.slice(0, 160);
const image = projectImagePath(project);
const logo = projectLogoPath(project);
const imageIsLogo = projectImageIsLogo(project);
const year = projectYear(project);
const pageUrl = new URL(`/projects/${project.id}/`, Astro.site).href;
const site = Astro.site?.href || 'https://gerald-clark.com';
const status = project.status || 'online';
const isUpsertPlugin =
  project.company === 'Upsert, LLC' && (project.id || '').startsWith('plugin-');
const isOpenSource = (project.urls || []).some((link) =>
  /github\.com/i.test(link.url || '')
);
const isWriting =
  (project.id || '').startsWith('blog-') ||
  /developer guide|certification/i.test(project.name || '');

/** Human-readable project kind for employers and buyers. */
function projectKind() {
  if (isWriting) return 'Writing / thought leadership';
  if (isUpsertPlugin) return 'Commercial SugarAI plugin';
  if (isOpenSource) return 'Open-source SugarAI add-on';
  if (project.company === 'SugarCRM') return 'Product & platform work';
  return 'Project';
}

function linkLabel(link) {
  const label = (link.label || '').trim();
  const url = link.url || '';
  if (/github\.com/i.test(url)) return 'View source on GitHub';
  if (/upsertconsulting\.com\/plugins/i.test(url)) return 'View product page';
  if (/upsertconsulting\.com\/blog/i.test(url) || /\/blog\//i.test(url)) {
    return 'Read the article';
  }
  if (/download/i.test(label)) return 'Download';
  if (label && label !== 'View Project') return label;
  if (isUpsertPlugin) return 'View product page';
  return 'Open link';
}

const kind = projectKind();
/** Soft year phrase for the header (no "Timeline" label). */
const yearPhrase = (() => {
  if (project.start_year && project.end_year && project.start_year !== project.end_year) {
    return `${project.start_year}–${project.end_year}`;
  }
  if (year == null) return null;
  if (isUpsertPlugin && !project.end_year) return `Since ${year}`;
  if (status === 'completed' || status === 'deprecated') return String(year);
  if (!project.end_year) return `Since ${year}`;
  return String(year);
})();

const facts = [
  { label: 'Type', value: kind },
  project.company ? { label: 'Organization', value: project.company } : null,
  status ? { label: 'Status', value: formatProjectStatus(status) } : null,
].filter(Boolean);

const primaryLinks = (project.urls || []).map((link, index) => ({
  ...link,
  displayLabel: linkLabel(link),
  isPrimary:
    index === 0 ||
    /upsertconsulting\.com\/plugins|github\.com/i.test(link.url || ''),
}));

const jsonLd = [
  projectSchema(project, pageUrl),
  breadcrumbSchema([
    { name: 'Home', url: site },
    { name: 'Projects', url: new URL('/projects/', site).href },
    { name: project.name, url: pageUrl },
  ]),
];
---

<Base title={title} description={description} image={image} ogType="article" jsonLd={jsonLd}>
  <div class="dashboard-container project-shell">
    <StatusBar active="projects" />
    <main class="dashboard project-browser-page">
      <ProjectBrowser activeId={project.id} mode="detail">
        <a class="mobile-projects-back" href="/projects/">
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
          All projects
        </a>

        <nav class="project-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/projects/">Projects</a>
          <span aria-hidden="true">/</span>
          <span>{project.name}</span>
        </nav>

        <header class="logs-detail-header">
          <div class="logs-detail-title">
            <div class="logs-detail-title-main">
              {logo && <img class="logs-detail-logo" src={logo} alt="" width="48" height="48" />}
              <h1>{project.name}</h1>
            </div>
            <span class={`logs-detail-status ${status}`}>{formatProjectStatus(status)}</span>
          </div>
          <p class="project-meta">{[kind, project.company, yearPhrase].filter(Boolean).join(' · ')}</p>
        </header>

        {
          primaryLinks.length > 0 && (
            <div class="project-actions">
              {primaryLinks.map((link) => (
                <a
                  class:list={['project-action', { primary: link.isPrimary }]}
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.displayLabel}
                </a>
              ))}
            </div>
          )
        }

        {
          image && (
            <div class:list={['logs-detail-featured-image', { 'is-logo': imageIsLogo }]}>
              <button
                type="button"
                class="project-image-lightbox-trigger"
                data-project-image-lightbox
                data-full-src={image}
                aria-label={`Show larger preview of ${project.name}`}
              >
                <img src={image} alt={`Screenshot or logo for ${project.name}`} loading="lazy" />
              </button>
            </div>
          )
        }

        <section class="logs-detail-section">
          <h2>{isUpsertPlugin ? 'What it does' : 'Overview'}</h2>
          <p class="project-description-full">{project.description || summary}</p>
        </section>

        <section class="logs-detail-section">
          <h2>At a glance</h2>
          <dl class="project-facts">
            {
              facts.map((fact) => (
                <>
                  <dt>{fact.label}</dt>
                  <dd class={fact.label === 'Status' ? 'fact-status' : undefined}>{fact.value}</dd>
                </>
              ))
            }
          </dl>
        </section>

        {
          (project.tech || []).length > 0 && (
            <section class="logs-detail-section">
              <h2>{isUpsertPlugin ? 'Built with' : 'Skills demonstrated'}</h2>
              <div class="project-tech">
                {project.tech.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </section>
          )
        }
      </ProjectBrowser>
    </main>
    {image && !imageIsLogo && <ProjectImageLightbox />}
  </div>
</Base>

<style>
  .project-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .project-breadcrumb a {
    color: var(--accent-orange);
    text-decoration: none;
  }

  .logs-detail-title-main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .logs-detail-title-main h1 {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.2rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .project-meta {
    margin-top: 0.35rem;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 0.75rem;
  }

  .project-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.15rem;
    border-radius: 6px;
    border: 2px solid var(--border-color);
    background: var(--card-bg);
    color: var(--text-primary);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .project-action.primary {
    border-color: var(--accent-orange);
    background: var(--accent-orange);
    color: #fff;
    box-shadow: 0 2px 10px rgba(249, 115, 22, 0.35);
  }

  .project-action:hover {
    border-color: var(--accent-orange);
    transform: translateY(-1px);
  }

  .project-action.primary:hover {
    background: var(--accent-orange-dark);
    border-color: var(--accent-orange-dark);
    color: #fff;
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.45);
  }

  .mobile-projects-back {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-projects-back {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0 0 1rem;
      padding: 0.65rem 0.85rem;
      border-radius: 6px;
      border: 1px solid var(--border-color);
      background: var(--card-bg);
      color: var(--text-primary);
      text-decoration: none;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .project-breadcrumb {
      display: none;
    }

    .project-actions {
      position: sticky;
      top: 0;
      z-index: 1;
      padding: 0.5rem 0;
      margin-top: 0.5rem;
      background: var(--bg-primary);
    }

    .project-action {
      flex: 1 1 100%;
    }

    .logs-detail-title-main {
      flex-wrap: wrap;
    }

    .logs-detail-title-main h1 {
      font-size: 1.25rem;
      line-height: 1.3;
    }
  }

  .logs-detail-section {
    margin-top: 1.75rem;
  }

  .logs-detail-section h2 {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    color: var(--accent-orange);
    font-family: 'JetBrains Mono', monospace;
  }

  .project-description-full {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .project-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.45rem 1.25rem;
    margin: 0;
  }

  .project-facts dt {
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }

  .project-facts dd {
    margin: 0;
    color: var(--text-primary);
  }

</style>
