---
import Base from '../../layouts/Base.astro';
import StatusBar from '../../components/StatusBar.astro';
import ProjectBrowser from '../../components/ProjectBrowser.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/portfolio.js';
import { projectListSchema, breadcrumbSchema } from '../../lib/schema.js';

const projects = getProjects();
const description =
  'All projects by Gerald Clark, including Upsert SugarAI plugins, open-source tools, and consulting work.';

const site = Astro.site?.href || 'https://gerald-clark.com';
const jsonLd = [
  projectListSchema(projects),
  breadcrumbSchema([
    { name: 'Home', url: site },
    { name: 'Projects', url: new URL('/projects/', site).href },
  ]),
];
---

<Base
  title="Projects | Gerald Clark"
  description={description}
  image="/img/logo.png"
  jsonLd={jsonLd}
>
  <div class="dashboard-container project-shell">
    <StatusBar active="projects" />
    <main class="dashboard project-browser-page">
      <ProjectBrowser mode="list">
        <div class="projects-index">
          <header class="projects-index-header desktop-only-empty">
            <h1>All projects</h1>
            <p>{projects.length} projects · sidebar shows the most recent</p>
          </header>
          <div class="projects-grid projects-index-grid">
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </div>
      </ProjectBrowser>
    </main>
  </div>
</Base>

<style>
  .projects-index-header {
    margin-bottom: 1.25rem;
  }

  .projects-index-header h1 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .projects-index-header p {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .projects-index-grid {
    padding-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .desktop-only-empty {
      display: none;
    }

    .projects-index {
      padding: 0;
    }
  }
</style>
