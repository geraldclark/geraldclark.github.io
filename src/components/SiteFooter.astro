---
const year = new Date().getFullYear();
---

<section class="footer-nav-section">
  <div class="footer-nav-content">
    <div class="footer-contact">
      <div class="footer-contact-item">
        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
        <span>Pittsburgh, PA</span>
      </div>
      <a
        href="https://github.com/geraldclark"
        class="footer-contact-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-github" aria-hidden="true"></i>
        <span>github.com/geraldclark</span>
      </a>
      <a
        href="https://linkedin.com/in/geraldclark"
        class="footer-contact-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-linkedin" aria-hidden="true"></i>
        <span>linkedin.com/in/geraldclark</span>
      </a>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/" class="footer-nav-link" data-section="home"
        ><i class="fas fa-terminal" aria-hidden="true"></i><span>Terminal</span></a
      >
      <a href="/#about" class="footer-nav-link" data-section="about"
        ><i class="fab fa-js" aria-hidden="true"></i><span>About</span></a
      >
      <a href="/#projects" class="footer-nav-link" data-section="projects"
        ><i class="fas fa-file-alt" aria-hidden="true"></i><span>Projects</span></a
      >
      <a href="/#skills" class="footer-nav-link" data-section="skills"
        ><i class="fas fa-cog" aria-hidden="true"></i><span>Skills</span></a
      >
      <a href="/#distinctions" class="footer-nav-link" data-section="distinctions"
        ><i class="fas fa-certificate" aria-hidden="true"></i><span>Distinctions</span></a
      >
      <a href="/#contact" class="footer-nav-link" data-section="contact"
        ><i class="fab fa-markdown" aria-hidden="true"></i><span>Contact</span></a
      >
    </nav>
  </div>
</section>

<footer class="dashboard-footer">
  <div class="footer-content">
    <span class="footer-text">
      © {year} Gerald Clark | System Status:
      <span class="status-online">OPERATIONAL</span>
    </span>
  </div>
</footer>
