<div class="modal-overlay" id="close-tab-modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title">Close tab</h3>
      <button class="modal-close" id="close-tab-modal-close-btn" type="button" aria-label="Close modal">
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
    </div>
    <div class="modal-body">
      <p class="modal-message" id="close-tab-message">
        Are you sure that you want to close this tab? You cannot undo this action.
      </p>
    </div>
    <div class="modal-footer">
      <button class="modal-btn modal-btn-cancel" id="close-tab-cancel-btn" type="button">Cancel</button>
      <button class="modal-btn modal-btn-delete" id="close-tab-confirm-btn" type="button">Close tab</button>
    </div>
  </div>
</div>
